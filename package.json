{
  "name": "lazonube",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "prisma:format": "prisma format",
    "prisma:format:check": "prisma format --check",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "worker:dev": "tsx watch worker/index.ts",
    "worker:build": "tsup worker/index.ts --format esm --platform node --out-dir .output-worker",
    "worker:start": "node .output-worker/index.js",
    "openapi:check": "redocly lint docs/openapi/openapi.yaml",
    "ci": "npm run check:lockfiles && npm run format:check && npm run lint && npm run typecheck && npm run prisma:format:check && npm run prisma:validate && npm run openapi:check && npm run test:unit && npm run test:integration && npm run build && npm run worker:build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxtjs/i18n": "^10.5.0",
    "@pinia/nuxt": "^1.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nuxt": "^10.68.0",
    "@vueuse/nuxt": "^14.3.0",
    "better-auth": "^1.6.25",
    "nuxt": "^4.5.1",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.62.0",
    "@redocly/cli": "^2.41.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/pg": "^8.20.0",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "wait-on": "^9.1.0"
  }
}
